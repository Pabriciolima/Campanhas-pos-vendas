{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        "node_modules/@types/react"
      ],
      "react-dom/client": [
        "node_modules/@types/react-dom/client"
      ],
      "recharts": [
        "node_modules/recharts"
      ]
    }
  },
  "include": [
    "../services/**/*.ts",
    "../components/diretoria/**/*.tsx",
    "remote.d.ts"
  ]
}
